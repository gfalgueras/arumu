#!/usr/bin/env bash
set -e

echo "[pre-push] Running build validation..."

echo "[pre-push] TypeScript check..."
pnpm typecheck

echo "[pre-push] Building..."
pnpm build

echo "[pre-push] Verifying output..."
[[ -f out/main/index.cjs ]]   || { echo "FAIL: out/main/index.cjs missing"; exit 1; }
[[ -f out/preload/index.js ]] || { echo "FAIL: out/preload/index.js missing"; exit 1; }
[[ -f out/renderer/index.html ]] || { echo "FAIL: out/renderer/index.html missing"; exit 1; }

echo "[pre-push] OK"
