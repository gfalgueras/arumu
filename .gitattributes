# Normalize line endings: LF in the repository, always.
# Prevents whole-file CRLF diffs when working across Windows/Linux/macOS.
* text=auto eol=lf

# Source
*.ts    text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.xml   text eol=lf

# Shell scripts must keep LF or they break on Linux/macOS
*.sh    text eol=lf

# Windows-native scripts keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Lockfiles: LF, and hide from diffs
pnpm-lock.yaml  text eol=lf -diff linguist-generated
package-lock.json text eol=lf -diff linguist-generated

# Binaries: never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.node  binary
*.db    binary
*.sqlite binary
